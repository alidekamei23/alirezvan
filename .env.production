# Public build-time settings for the live build. Liara's build does not see the app's
# environment variables, and NEXT_PUBLIC_* values are fixed at build time, so they live
# here. No secrets in this file: secrets stay in the Liara console (or .env.local).

# Change to the real domain when it is connected.
NEXT_PUBLIC_SITE_URL=https://alirezvanlegal.liara.run

# "true" only on the real domain, after the lawyer has approved the copy.
NEXT_PUBLIC_ALLOW_INDEXING=false
