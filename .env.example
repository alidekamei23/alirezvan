# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL, no trailing slash (canonical URLs, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Needed from session 6 onward ---

# PostgreSQL connection string
DATABASE_URL=

# SMS gateway (Kavenegar) and the approved OTP template name
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

# Bale bot for lead alerts
BALE_BOT_TOKEN=
BALE_CHAT_ID=

# /admin HTTP basic auth
ADMIN_USERNAME=
ADMIN_PASSWORD=
