{
  "name": "alirezvan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:contrast": "node scripts/check-contrast.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types --no-warnings scripts/migrate.ts",
    "hash-password": "node scripts/hash-password.mjs",
    "unlock-login": "node --experimental-strip-types --no-warnings scripts/unlock-login.ts",
    "uploads:clean": "node --experimental-strip-types --no-warnings scripts/clean-uploads.ts",
    "revoke-sessions": "node --experimental-strip-types --no-warnings scripts/revoke-sessions.ts",
    "review:hubs": "node --experimental-strip-types --no-warnings scripts/export-review.ts",
    "blog:cover": "node scripts/blog-cover.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "date-fns-jalali": "^4.4.0-0",
    "drizzle-orm": "^0.45.4",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.55.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
