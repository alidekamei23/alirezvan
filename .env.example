# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL, no trailing slash (canonical URLs, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "true" only on the real domain, after the lawyer has approved the copy. Any other value
# keeps search engines out (robots.txt disallows everything and pages carry noindex).
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Database and admin panel ---

# SQLite file, outside the build output. Relative paths start at the project folder.
# On Liara use absolute paths on the disk (the standalone server changes its working
# folder): DATABASE_URL=file:/app/data/alirezvan.db and UPLOAD_DIR=/app/data/uploads
# Create or update it with: npm run db:migrate
DATABASE_URL=file:./data/alirezvan.db

# Folder for uploaded images, outside the build output
UPLOAD_DIR=./data/uploads

# The one administrator
ADMIN_USERNAME=admin
# Run "npm run hash-password" and paste the whole line it prints over the next line.
# The hash contains "$" signs; each one must stay written as "\$".
ADMIN_PASSWORD_HASH=
# Signs the session cookie: at least 32 random characters. Make one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every browser out.
SESSION_SECRET=

# Name of the header in which the reverse proxy passes the visitor's IP address
# (e.g. x-real-ip). Leave empty when there is no proxy, as in local development: such
# headers can be forged, so the login limit then counts all visitors together.
TRUSTED_IP_HEADER=

# --- Q&A section (/porsesh) ---

# Secret for hashing visitors' IP addresses (spam limits) and signing form timestamps:
# at least 32 random characters. Required in production; development uses a placeholder.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it resets the per-address limits, nothing else.
IP_HASH_SALT=

# New questions allowed per IP address per hour (default 3)
QUESTION_LIMIT_PER_HOUR=3

# --- Needed later (request form and leads) ---

# SMS gateway (Kavenegar) and the approved OTP template name
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

# Bale bot for lead alerts
BALE_BOT_TOKEN=
BALE_CHAT_ID=
